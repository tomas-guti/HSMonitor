<Window x:Class="HardwareMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hardware Monitor"
        Height="480"
        Width="760"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#101218"
        Foreground="#ECEEF4">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#8E9AAF"
                       Text="HARDWARE MONITOR" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Monitorización de hardware" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,28"
                Padding="24"
                CornerRadius="10"
                Background="#191D26"
                BorderBrush="#292F3B"
                BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="La adquisición de sensores aún no está habilitada." />
                <TextBlock Margin="0,10,0,0"
                           MaxWidth="560"
                           FontSize="13"
                           Foreground="#AAB2C2"
                           TextWrapping="Wrap"
                           Text="Esta base no muestra valores simulados. La detección de hardware y el motor de monitorización se incorporarán en la siguiente fase." />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="#8E9AAF"
                   Text="Fase 1 · Base de la aplicación" />
    </Grid>
</Window>
